PORT=3001
LOG_LEVEL=info

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_MODEL=gpt-4o

REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://gracesoft:gracesoft@postgres:5432/gracesoft_sentinel

# "Mother's Day Edition" (optional): personal recipe retrieval via RAG over
# a Google Drive folder, instead of generating a recipe from a photo. Leave
# GOOGLE_DRIVE_RECIPES_FOLDER_ID unset to disable this feature entirely —
# nothing else about Cook's behavior changes. When set, the two service
# account vars below become required.
GOOGLE_DRIVE_RECIPES_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

WHATSAPP_ENABLED=false
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
